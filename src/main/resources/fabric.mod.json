{
  "schemaVersion": 1,
  "id": "musicloader",
  "version": "${version}",
  "name": "Music Loader",
  "description": "Музыкальный плеер в меню паузы (Esc): кружок с иконкой песни, стрелки влево/вправо, загрузка песен из папки musicloader.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.musicloader.MusicLoaderClient"]
  },
  "mixins": ["musicloader.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
